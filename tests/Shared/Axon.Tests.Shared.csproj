<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress test-specific analyzer warnings for test utilities -->
    <NoWarn>CA1062;CA1822;CA1869;NUnit1033</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Shared/Common/Axon.Shared.Common.csproj" />
    <ProjectReference Include="../../src/Shared/Common.Abstractions/Axon.Shared.Common.Abstractions.csproj" />
    <ProjectReference Include="../../src/Modules/Chat/Domain/Axon.Modules.Chat.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Chat/Application/Axon.Modules.Chat.Application.csproj" />
    <ProjectReference Include="../Axon.ArchitectureTests.Framework/Axon.ArchitectureTests.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Shouldly" />
    <Using Include="Moq" />
    <Using Include="Axon.Shared.Common" />
    <Using Include="Axon.Shared.Common.Abstractions" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Text" />
  </ItemGroup>

</Project>