### Observability & Telemetry

**Built-in Production Monitoring**

The SDK provides comprehensive telemetry hooks for tracking errors, performance, and usage metrics in production.

**Configuration:**

```typescript
import { AxonClient } from '@axon-ai/sdk-core';
import * as Sentry from '@sentry/browser';

const axon = new AxonClient({
  environment: 'mainnet',

  // Option 1: Sentry Integration
  telemetry: {
    provider: 'sentry',
    dsn: process.env.SENTRY_DSN,
    trackErrors: true,
    trackPerformance: true,
    trackUsage: true,
    sampleRate: 1.0, // 100% in staging, 0.1 in prod
    environment: process.env.NODE_ENV
  },

  // Option 2: Datadog Integration
  telemetry: {
    provider: 'datadog',
    apiKey: process.env.DATADOG_API_KEY,
    service: 'axon-sdk',
    trackErrors: true,
    trackPerformance: true
  },

  // Option 3: Custom Telemetry
  telemetry: {
    provider: 'custom',
    onError: (error, context) => {
      // Send to your error tracking service
      console.error('[SDK Error]', error, context);
      yourErrorTracker.capture(error, {
        ...context,
        user: context.user,
        environment: 'production'
      });
    },
    onMetric: (metric, value, tags) => {
      // Send to your metrics service
      yourMetrics.track(metric, value, tags);
    },
    onEvent: (event, data) => {
      // Track SDK usage events
      yourAnalytics.track(event, data);
    }
  }
});
```

