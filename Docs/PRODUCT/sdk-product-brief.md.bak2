## API Reference

**Use Case:** React apps that want pre-built chat UI with hooks and theming.

**Installation:**

```bash
npm install @axon-ai/sdk-react @axon-ai/sdk-chat-ui
```

**Usage:**

```typescript
import { AxonProvider, AxonChatBubble } from '@axon-ai/sdk-react';
import { DynamicContextProvider, useDynamicContext } from '@dynamic-labs/sdk-react-core';

function App() {
  return (
    <DynamicContextProvider settings={{ /* Dynamic config */ }}>
      <AxonIntegration />
    </DynamicContextProvider>
  );
}

function AxonIntegration() {
  const { authToken } = useDynamicContext();

  return (
    <AxonProvider
      config={{
        environment: 'mainnet',
        authMode: 'dynamic',
        dynamicToken: authToken,  // Auto-exchange on mount
        onAuthSuccess: (userId) => {
          console.log('Authenticated with Axon:', userId);
        },
        onError: (error) => {
          console.error('Axon error:', error);
        }
      }}
    >
      <YourApp />

      {/* Chat bubble with built-in UI */}
      <AxonChatBubble
        position="bottom-right"
        theme={{
          colors: {
            primary: '#7C3AED',
            background: '#1F2937',
            text: '#F9FAFB'
          },
          typography: {
            fontFamily: 'Geist, system-ui, sans-serif'
          },
          borderRadius: '16px'
        }}
        greetingMessage="👋 Hi! I'm your AI assistant. How can I help?"
        placeholder="Ask me anything..."
        onConversationStart={(conversationId) => {
          // Track in analytics
          analytics.track('conversation_started', { conversationId });
        }}
        onMessageSent={(message) => {
          // Track message sent
          analytics.track('message_sent', {
            conversationId: message.conversationId,
            length: message.content.length
          });
        }}
      />
    </AxonProvider>
  );
}
```

**Props:**

```typescript
interface AxonChatBubbleProps {
  // Positioning
  position?: 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left';
  offset?: { x: number; y: number };  // Pixels from edge

  // Theming
  theme?: Partial<AxonTheme>;

  // Content
  greetingMessage?: string;
  placeholder?: string;
  emptyStateMessage?: string;

  // Behavior
  autoOpen?: boolean;              // Open on mount
  defaultOpen?: boolean;           // Controlled state
  onOpenChange?: (open: boolean) => void;

  // Conversation
  conversationId?: string;         // Resume specific conversation
  onConversationStart?: (id: string) => void;
  onConversationEnd?: (id: string) => void;

  // Messages
  onMessageSent?: (message: Message) => void;
  onMessageReceived?: (message: Message) => void;

  // Styling
  className?: string;
  style?: React.CSSProperties;
}
```

**Theming:**

```typescript
interface AxonTheme {
  colors: {
    primary: string;           // Brand color (buttons, links)
    background: string;        // Chat window background
    surface: string;           // Message bubbles, inputs
    text: string;              // Primary text
    textSecondary: string;     // Timestamps, hints
    border: string;            // Borders, dividers
    error: string;             // Error messages
    success: string;           // Success states
    userMessage: string;       // User message bubble color
    assistantMessage: string;  // Assistant message bubble color
  };
  typography: {
    fontFamily: string;
    fontSize: {
      xs: string;   // 12px
      sm: string;   // 14px
      md: string;   // 16px
      lg: string;   // 18px
    };
    fontWeight: {
      normal: number;  // 400
      medium: number;  // 500
      semibold: number; // 600
      bold: number;    // 700
    };
  };
  spacing: {
    xs: string;   // 4px
    sm: string;   // 8px
    md: string;   // 16px
    lg: string;   // 24px
    xl: string;   // 32px
  };
  borderRadius: string;  // Global border radius
  shadows: {
    sm: string;   // Subtle shadow
    md: string;   // Default shadow
    lg: string;   // Elevated shadow
  };
}
```

**Preset Themes:**

```typescript
import { themes } from '@axon-ai/sdk-chat-ui';

<AxonChatBubble theme={themes.dark} />
<AxonChatBubble theme={themes.light} />
<AxonChatBubble theme={themes.minimal} />
<AxonChatBubble theme={themes.vibrant} />
```

