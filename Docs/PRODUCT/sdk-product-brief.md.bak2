### Mode 3: Headless Hooks (Custom UI)

**Use Case:** Full control over chat UI, use Axon as headless backend.

**Installation:**

```bash
npm install @axon-ai/sdk-react
```

**Hooks:**

```typescript
// Authentication
const { isAuthenticated, user, signIn, signOut } = useAxonAuth();

// Single conversation
const {
  messages,
  sendMessage,
  isLoading,
  error
} = useConversation(conversationId);

// Conversation list
const {
  conversations,
  isLoading,
  refresh
} = useConversations();

// Message list with pagination
const {
  messages,
  loadMore,
  hasMore,
  isLoading
} = useMessages(conversationId);
```

**Example: Custom Chat UI**

```typescript
import { useAxonAuth, useConversation } from '@axon-ai/sdk-react';

function CustomChatUI() {
  const { isAuthenticated, signIn, user } = useAxonAuth();
  const [conversationId, setConversationId] = useState<string>();

  const {
    messages,
    sendMessage,
    isLoading,
    error
  } = useConversation(conversationId);

  const [input, setInput] = useState('');

  if (!isAuthenticated) {
    return (
      <div className="auth-prompt">
        <h2>Connect Wallet to Chat</h2>
        <button onClick={signIn}>Connect Wallet</button>
      </div>
    );
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!input.trim()) return;

    try {
      const response = await sendMessage(input);
      setConversationId(response.conversationId);  // Set on first message
      setInput('');
    } catch (err) {
      console.error('Failed to send message:', err);
    }
  };

  return (
    <div className="custom-chat">
      <div className="chat-header">
        <h3>AI Assistant</h3>
        <span>Logged in as {user.axonUserId}</span>
      </div>

      <div className="messages">
        {messages.map(msg => (
          <div
            key={msg.messageId}
            className={`message ${msg.role}`}
          >
            <div className="content">{msg.content}</div>
            <time>{new Date(msg.createdAt).toLocaleTimeString()}</time>
          </div>
        ))}

        {isLoading && <div className="loading">Thinking...</div>}
        {error && <div className="error">{error.message}</div>}
      </div>

      <form onSubmit={handleSubmit}>
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          placeholder="Ask me anything..."
          disabled={isLoading}
        />
        <button type="submit" disabled={isLoading || !input.trim()}>
          Send
        </button>
      </form>
    </div>
  );
}
```

**Hook API Reference:**

```typescript
// useAxonAuth()
function useAxonAuth(): {
  isAuthenticated: boolean;
  user: User | null;
  isLoading: boolean;
  signIn: () => Promise<void>;
  signOut: () => Promise<void>;
  refreshAuth: () => Promise<void>;
}

// useConversation()
function useConversation(conversationId?: string): {
  messages: Message[];
  sendMessage: (text: string) => Promise<ChatTurnResponse>;
  isLoading: boolean;
  error: Error | null;
  retry: () => void;
}

// useConversations()
function useConversations(params?: {
  pageSize?: number;
  sortBy?: string;
}): {
  conversations: Conversation[];
  isLoading: boolean;
  error: Error | null;
  loadMore: () => Promise<void>;
  hasMore: boolean;
  refresh: () => Promise<void>;
}

// useMessages()
function useMessages(conversationId: string, params?: {
  pageSize?: number;
}): {
  messages: Message[];
  isLoading: boolean;
  error: Error | null;
  loadMore: () => Promise<void>;
  hasMore: boolean;
  refresh: () => Promise<void>;
}
```

---

### Mode 4: TanStack Query Integration (Production Recommended)

**Use Case:** Production apps needing automatic caching, background refetching, optimistic updates, and stale-while-revalidate patterns.

**Why TanStack Query:**
- Industry standard for data fetching (wagmi v2, Vercel AI SDK use it)
- Automatic caching with configurable staleness
- Background refetching and invalidation
- Optimistic updates for instant UI feedback
- Request deduplication (multiple components fetch same data → single request)

**Installation:**

```bash
npm install @axon-ai/sdk-react-query @tanstack/react-query
```

**Usage:**

```typescript
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { AxonProvider } from '@axon-ai/sdk-react';
import {
  useConversationQuery,
  useConversationsQuery,
  useMessagesQuery,
  useSendMessageMutation
} from '@axon-ai/sdk-react-query';

// Setup
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 30_000, // Data fresh for 30s
      cacheTime: 5 * 60 * 1000, // Cache for 5 min
      refetchOnWindowFocus: true,
      retry: 3
    }
  }
});

function App() {
  return (
    <QueryClientProvider client={queryClient}>
      <AxonProvider config={{ environment: 'mainnet' }}>
        <ChatInterface />
      </AxonProvider>
    </QueryClientProvider>
  );
}

// Component using TanStack Query hooks
function ChatInterface() {
  const [conversationId, setConversationId] = useState<string>();

  // Fetch messages with automatic caching
  const {
    data: messages,
    isLoading,
    error,
    refetch
  } = useMessagesQuery(conversationId, {
    enabled: !!conversationId,
    refetchInterval: 60_000 // Poll every 60s for new messages
  });

  // Send message with optimistic updates
  const sendMessageMutation = useSendMessageMutation({
    onMutate: async (newMessage) => {
      // Cancel outgoing refetches
      await queryClient.cancelQueries(['messages', conversationId]);

      // Snapshot previous value
      const previousMessages = queryClient.getQueryData(['messages', conversationId]);

      // Optimistically update to the new value
      queryClient.setQueryData(['messages', conversationId], (old: any) => [
        ...old,
        {
          messageId: 'temp-' + Date.now(),
          role: 'user',
          content: newMessage,
          createdAt: new Date().toISOString(),
          sequence: old.length + 1
        }
      ]);

      return { previousMessages };
    },
    onError: (err, newMessage, context) => {
      // Rollback on error
      queryClient.setQueryData(['messages', conversationId], context?.previousMessages);
    },
    onSuccess: (data) => {
      // Invalidate and refetch
      queryClient.invalidateQueries(['messages', conversationId]);
      queryClient.invalidateQueries(['conversations']);
    }
  });

  const handleSendMessage = async (text: string) => {
    try {
      const response = await sendMessageMutation.mutateAsync({
        conversationId,
        message: text
      });
      setConversationId(response.conversationId);
    } catch (error) {
      console.error('Failed to send message:', error);
    }
  };

  return (
    <div className="chat-interface">
      {/* UI with messages, optimistic updates work automatically */}
      {messages?.map(msg => (
        <MessageBubble key={msg.messageId} message={msg} />
      ))}
    </div>
  );
}
```

**Query Hooks:**

```typescript
// useConversationQuery - Single conversation with messages
const { data, isLoading, error, refetch, isFetching } = useConversationQuery(
  conversationId,
  {
    staleTime: 30_000,
    enabled: !!conversationId,
    refetchOnWindowFocus: true
  }
);

// useConversationsQuery - List all conversations
const { data, isLoading, error, fetchNextPage, hasNextPage } = useConversationsQuery({
  pageSize: 20,
  sortBy: 'UpdatedAt'
});

// useMessagesQuery - Messages for a conversation (paginated)
const { data, isLoading, error, fetchNextPage, hasNextPage } = useMessagesQuery(
  conversationId,
  {
    pageSize: 50,
    enabled: !!conversationId
  }
);
```

**Mutation Hooks:**

```typescript
// useSendMessageMutation - Send message with optimistic updates
const mutation = useSendMessageMutation({
  onMutate,
  onError,
  onSuccess
});

await mutation.mutateAsync({ conversationId, message: 'Hello!' });
```

**Benefits:**
- ✅ **Automatic caching**: Same data fetched once, shared across components
- ✅ **Optimistic updates**: UI feels instant, rollback on error
- ✅ **Background refetching**: Data stays fresh without user action
- ✅ **Request deduplication**: 10 components fetch same conversation → 1 HTTP request
- ✅ **Infinite scroll**: Built-in `fetchNextPage()` for pagination
- ✅ **DevTools**: React Query DevTools show cache state, queries, mutations

---

### Mode 5: Streaming Chat Responses (Real-Time AI)

**Use Case:** Stream AI responses token-by-token for immediate feedback (OpenAI/Anthropic-style streaming).

**Why Streaming:**
- **Perceived Performance**: Users see partial responses in ~200ms vs. 5-15s wait
- **Better UX**: Long responses don't feel frozen
- **Modern Standard**: OpenAI, Anthropic, Vercel AI SDK all stream by default

**Backend Support:**

Add streaming endpoint:
```
POST /api/v1/chat/turns/stream  (Server-Sent Events)
```

**SDK Usage:**

```typescript
import { useConversation } from '@axon-ai/sdk-react';

function StreamingChat() {
  const {
    messages,
    streamMessage,
    isStreaming,
    currentStreamedContent,
    error
  } = useConversation(conversationId);

  const handleSend = async (text: string) => {
    await streamMessage(text, {
      onToken: (token) => {
        // Called for each token received
        console.log('Token:', token);
      },
      onComplete: (fullMessage) => {
        // Called when stream completes
        console.log('Full message:', fullMessage);
      },
      onError: (error) => {
        console.error('Stream error:', error);
      }
    });
  };

  return (
    <div>
      {messages.map(msg => (
        <MessageBubble key={msg.messageId} message={msg} />
      ))}

      {/* Show streaming message in real-time */}
      {isStreaming && currentStreamedContent && (
        <MessageBubble
          message={{
            role: 'assistant',
            content: currentStreamedContent,
            isStreaming: true
          }}
        />
      )}
    </div>
  );
}
```

**Implementation (SDK Internal):**

```typescript
// ChatClient.ts (SDK Core)
async streamMessage(
  conversationId: string | undefined,
  message: string,
  callbacks: {
    onToken?: (token: string) => void;
    onComplete?: (message: Message) => void;
    onError?: (error: Error) => void;
  }
) {
  const eventSource = new EventSource(`/api/v1/chat/turns/stream`, {
    headers: {
      'Authorization': `Bearer ${this.authManager.getAccessToken()}`,
      'Content-Type': 'application/json'
    },
    method: 'POST',
    body: JSON.stringify({ conversationId, message })
  });

  let streamedContent = '';

  eventSource.addEventListener('token', (event) => {
    const token = JSON.parse(event.data).token;
    streamedContent += token;
    callbacks.onToken?.(token);
  });

  eventSource.addEventListener('complete', (event) => {
    const data = JSON.parse(event.data);
    eventSource.close();
    callbacks.onComplete?.(data.message);
  });

  eventSource.addEventListener('error', (event) => {
    const error = new Error(event.data || 'Stream error');
    eventSource.close();
    callbacks.onError?.(error);
  });
}
```

**Backend SSE Format:**

```
// Stream format (Server-Sent Events)
event: token
data: {"token": "The"}

event: token
data: {"token": " quick"}

event: token
data: {"token": " brown"}

event: complete
data: {"message": {...}, "conversationId": "..."}
```

**Benefits:**
- ✅ **Instant Feedback**: Users see responses in ~200ms
- ✅ **Long Response UX**: 30-second responses don't feel frozen
- ✅ **Matches Industry Standards**: Same UX as ChatGPT, Claude, Vercel AI SDK
- ✅ **Efficient**: SSE protocol, auto-reconnect on network drops

---

### Chat API Integration (Backend)

**Universal Endpoint: `POST /api/v1/chat/turns`**

This single endpoint handles **both** starting new conversations and continuing existing ones.

```typescript
// Start new conversation (conversationId = null)
const response = await axon.chat.sendMessage({
  message: "Hello, who are you?"
});
// Returns: { conversationId, userMessageId, assistantMessageId, assistantMessage }

// Continue conversation
const response = await axon.chat.sendMessage({
  conversationId: "existing-conversation-id",
  message: "Tell me more"
});
```

**Request:**
```typescript
interface ChatTurnRequest {
  conversationId?: string;  // null = start new, present = continue
  message: string;          // 1-32,000 characters
}
```

**Response:**
```typescript
interface ChatTurnResponse {
  conversationId: string;        // UUID
  userMessageId: string;         // UUID
  assistantMessageId: string;    // UUID
  assistantMessage: string;      // AI response content
  timestamp: string;             // ISO 8601
}
```

**Backend Flow:**
1. If `conversationId` is null → `StartConversationHandler`
2. If `conversationId` is present → `AppendUserMessageHandler`
3. Persist user message
4. Call `MessageProcessingOrchestrator`:
   - Resolve MCP servers (for extended AI capabilities)
   - Call Claude API with conversation history
   - Use `previous_response_id` for prompt caching (saves money)
5. Persist assistant message (idempotent via `AiResponseId`)
6. Return response

**Idempotency:** If same `AiResponseId` already exists, returns existing message without calling Claude API again (prevents duplicate API calls on retry).

---

**List Conversations: `GET /api/v1/chat/conversations`**

```typescript
const conversations = await axon.chat.getConversations({
  pageSize: 20,
  pageNumber: 1,
  sortBy: 'UpdatedAt',  // CreatedAt | UpdatedAt
  sortDirection: 'desc',
  titleContains: 'solana'  // Optional search
});

interface PaginatedConversations {
  items: ConversationItem[];
  pageNumber: number;
  pageSize: number;
  totalCount: number;
  totalPages: number;
  hasNext: boolean;
  hasPrevious: boolean;
}

interface ConversationItem {
  conversationId: string;
  title: string;  // Generated from first message
  createdAt: string;
  updatedAt: string;
  lastAssistantResponseId: string | null;
}
```

---

**Get Messages: `GET /api/v1/chat/conversations/{id}/messages`**

```typescript
const messages = await axon.chat.getMessages(conversationId, {
  pageSize: 50,
  pageNumber: 1,
  includeDeleted: false
});

interface PaginatedMessages {
  items: ConversationMessage[];
  pageNumber: number;
  pageSize: number;
  totalCount: number;
  totalPages: number;
  hasNext: boolean;
  hasPrevious: boolean;
}

interface ConversationMessage {
  messageId: string;
  role: 'user' | 'assistant';
  content: string;
  createdAt: string;
  sequence: number;  // Message order in conversation
  aiResponseId: string | null;  // For assistant messages
}
```

