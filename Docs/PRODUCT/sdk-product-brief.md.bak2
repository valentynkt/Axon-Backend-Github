### Retry Logic (Built-In)

**SDK Automatic Retry:**

```typescript
// SDK retries these automatically with exponential backoff
const retriableErrors = [
  'NETWORK_ERROR',
  'SERVER_ERROR',
  'RATE_LIMITED',
  'TIMEOUT',
];

// Retry strategy
async function requestWithRetry(fn: () => Promise<any>, maxRetries = 3) {
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      return await fn();
    } catch (error) {
      if (!isRetriable(error) || attempt === maxRetries) {
        throw error;
      }

      const backoff = Math.min(1000 * 2 ** (attempt - 1), 10000);  // Max 10s
      await sleep(backoff);
    }
  }
}
```

**Rate Limit Handling:**

```typescript
// SDK respects Retry-After header
if (response.status === 429) {
  const retryAfter = parseInt(response.headers.get('Retry-After') ?? '60', 10);
  await sleep(retryAfter * 1000);
  return requestWithRetry(fn, maxRetries - 1);
}
```

