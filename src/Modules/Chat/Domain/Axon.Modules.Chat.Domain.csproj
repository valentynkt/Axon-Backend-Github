<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Temporarily disable problematic code analysis rules -->
    <NoWarn>$(NoWarn);CA1848;CA1826;CA1860;CA1862;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Shared/Common/Axon.Shared.Common.csproj" />
    <ProjectReference Include="../../../Shared/Domain/Axon.Shared.Domain.csproj" />
  </ItemGroup>

</Project>