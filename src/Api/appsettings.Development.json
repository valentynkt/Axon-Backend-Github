{
  "Cors": {
    "PolicyName": "DevelopmentPolicy",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:4200",
      "https://localhost:3000",
      "https://localhost:3001", 
      "https://localhost:5173",
      "https://localhost:4200",
      "https://dev-app.axon.ai",
      "https://staging-app.axon.ai"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["*"],
    "AllowCredentials": true,
    "PreflightMaxAge": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error",
      "Microsoft.Extensions.Http": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Update": "Debug",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.NameResolution": "Error",
      "OpenTelemetry": "Error",
      "OpenTelemetry.Exporter": "Error",
      "OpenTelemetry.Instrumentation": "Error",
      "Axon": "Debug",
      "Axon.Modules.Chat.Application": "Information",
      "Axon.Modules.Chat.Infrastructure": "Information"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss.fff ",
        "UseUtcTimestamp": false
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Axon.API",
    "ServiceVersion": "1.0.0-dev",
    "TracingEnabled": true,
    "MetricsEnabled": false,
    "LoggingEnabled": false,
    "ConsoleExporter": {
      "Enabled": false,
      "MetricsInterval": 5000,
      "VerboseLogging": false
    }
  },
  "MassTransit": {
    "Transport": "InMemory",
    "EnableOutbox": true,
    "Durable": false,
    "EndpointPrefix": "dev-axon-",
    "PublishTimeout": "00:00:10",
    "IncludeEnvironmentHeaders": true,
    "Retry": {
      "MaxAttempts": 2,
      "InitialInterval": "00:00:00.100",
      "MaxInterval": "00:00:05",
      "IntervalIncrement": "00:00:00.100"
    }
  },
  "Dynamic": {
    "Authority": "https://app.dynamic.xyz/",
    "Audience": "test-audience",
    "JwksUri": "https://app.dynamic.xyz/.well-known/jwks",
    "Issuer": "https://app.dynamic.xyz"
  },
  "DynamicXyz": {
    "EnvironmentId": "test-env-id",
    "ApiUrl": "https://app.dynamic.xyz/api/v0"
  },
  "DynamicValidation": {
    "ValidateAudience": false,
    "ClockSkewSeconds": 300,
    "JwksCacheMinutes": 60,
    "TokenCacheMinutes": 30,
    "EnableBackgroundRefresh": false,
    "BackgroundRefreshMinutes": 30,
    "EnvironmentMapping": {
      "app.dynamicauth.com/test-env-id": "test"
    },
    "DefaultAllowedAudiences": ["test-audience"],
    "PartnerAudienceAllowlist": {}
  },
  "DatabaseOptions": {
    "EnableAutomaticMigrations": true
  },
  "Axon": {
    "Issuer": "axon-api",
    "Audience": "axon-platform",
    "SigningKey": "ZGV2ZWxvcG1lbnQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9uLTMyLWNoYXJzLW1pbmltdW0tYW5kLW1vcmU="
  },
  "Chat": {
    "UsePocMode": true,
    "OpenAi": {
      "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
      "Model": "gpt-4o",
      "MaxTokens": 4000,
      "Temperature": 0.7,
      "McpEnabled": true,
      "TimeoutSeconds": 60
    },
    "McpServers": {
      "Servers": {
        "CoinGecko": {
          "Enabled": true,
          "ServerUrl": "https://mcp.api.coingecko.com/sse",
          "ServerLabel": "coingecko-api",
          "RequireApproval": false,
          "TimeoutSeconds": 30,
          "AllowedTools": [
            "simple/price",
            "coins/markets",
            "coins/{id}",
            "coins/{id}/market_chart",
            "search/trending",
            "simple/token_price"
          ]
        }
      }
    }
  }
}
