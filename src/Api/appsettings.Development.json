{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Chat": {
    "McpServers": {
      "weather": {
        "Enabled": true,
        "ServerUrl": "https://dev-weather.example.com/mcp",
        "Headers": {
          "X-API-Key": "dev-weather-key"
        }
      },
      "finance": {
        "Enabled": true,
        "ServerUrl": "https://dev-finance.example.com/mcp",
        "Headers": {
          "Authorization": "Bearer dev-token"
        }
      }
    }
  }
}
