{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "OpenTelemetry": "Warning",
      "Axon": "Information",
      "Axon.Modules.Chat.Application": "Information",
      "Axon.Modules.Chat.Infrastructure": "Information"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss.fff ",
        "UseUtcTimestamp": false
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Axon.API",
    "ServiceVersion": "1.0.0-dev",
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "LoggingEnabled": true,
    "ConsoleExporter": {
      "Enabled": true,
      "MetricsInterval": 5000,
      "VerboseLogging": true
    }
  },
  "Chat": {
    "UsePocMode": true,
    "OpenAi": {
      "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
      "Model": "gpt-4o",
      "MaxTokens": 4000,
      "Temperature": 0.7,
      "McpEnabled": true,
      "TimeoutSeconds": 60
    },
    "McpServers": {
      "Servers": {
        "CoinGecko": {
          "Enabled": true,
          "ServerUrl": "https://mcp.api.coingecko.com/sse",
          "ServerLabel": "coingecko-api",
          "RequireApproval": false,
          "TimeoutSeconds": 30
        }
      }
    }
  }
}
