{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Chat": {
    "OpenAi": {
      "ApiKey": "{{OPENAI_API_KEY}}",
      "Model": "{{OPENAI_MODEL}}",
      "MaxTokens": "{{OPENAI_MAX_TOKENS}}",
      "Temperature": "{{OPENAI_TEMPERATURE}}",
      "McpEnabled": "{{OPENAI_MCP_ENABLED}}"
    }
  }
}
