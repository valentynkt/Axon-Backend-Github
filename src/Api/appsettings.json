{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Chat": {
    "OpenAi": {
      "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
      "Model": "gpt-4o",
      "MaxTokens": 4000,
      "TimeoutSeconds": 30,
      "Temperature": 0.7,
      "McpEnabled": true
    },
    "McpServers": {
      "weather": {
        "Enabled": true,
        "ServerUrl": "https://weather.example.com/mcp",
        "ServerLabel": "Weather Service",
        "Headers": {
          "X-API-Key": "weather-api-key-from-env"
        },
        "AllowedTools": ["get_weather", "get_forecast"],
        "TimeoutSeconds": 30
      },
      "finance": {
        "Enabled": false,
        "ServerUrl": "https://finance.example.com/mcp",
        "ServerLabel": "Finance Service",
        "AllowedTools": ["get_stock_price", "get_market_data"],
        "TimeoutSeconds": 60
      }
    }
  }
}
