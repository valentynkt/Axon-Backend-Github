{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=axon_chat;Username=postgres;Password=postgres;Command Timeout=60;Timeout=30;Pooling=true;MinPoolSize=5;MaxPoolSize=20;Include Error Detail=true",
    "Redis": "${REDIS_CONNECTION_STRING:localhost:6379,abortConnect=false,connectTimeout=5000}"
  },
  "Database": {
    "TransactionTimeoutMinutes": 5,
    "LongRunningOperationTimeoutMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error",
      "Microsoft.Extensions.Http": "Warning",
      "Microsoft.EntityFrameworkCore": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Transaction": "Debug",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Debug",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.NameResolution": "Error",
      "OpenTelemetry": "Error",
      "OpenTelemetry.Exporter": "Error",
      "OpenTelemetry.Instrumentation": "Error",
      "Axon": "Information"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss.fff ",
        "UseUtcTimestamp": false
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Axon.API",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "LoggingEnabled": false,
    "ConsoleExporter": {
      "Enabled": false,
      "MetricsInterval": 30000
    }
  },
  "Dynamic": {
    "Authority": "https://app.dynamic.xyz",
    "JwksUri": "https://app.dynamic.xyz/.well-known/jwks",
    "Issuer": "https://app.dynamic.xyz",
    "Audience": "axon-api"
  },
  "Authentication": {
    "Issuer": "axon-api",
    "Audience": "axon-platform",
    "SigningKey": "${AXON_JWT_SIGNING_KEY:ZGV2ZWxvcG1lbnQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9uLTMyLWNoYXJzLW1pbmltdW0=}",
    "HmacSecret": "${AXON_HMAC_SECRET:ZGV2ZWxvcG1lbnQtaG1hYy1zZWNyZXQtY2hhbmdlLWluLXByb2R1Y3Rpb24=}",
    "HmacKeys": {
      "v1": "${AXON_HMAC_KEY_V1:ZGV2ZWxvcG1lbnQtaG1hYy1rZXktdjEtY2hhbmdlLWluLXByb2R1Y3Rpb24=}"
    },
    "CurrentKeyVersion": "v1",
    "TokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30,
    "ClockSkewMinutes": 5
  },
  "AllowedHosts": "*",
  "Axon": {
    "Issuer": "axon-api",
    "Audience": "axon-platform",
    "SigningKey": "${AXON_JWT_SIGNING_KEY:ZGV2ZWxvcG1lbnQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9uLTMyLWNoYXJzLW1pbmltdW0=}"
  },
  "AzureKeyVault": {
    "VaultUri": "${AZURE_KEYVAULT_URI:}",
    "JwtSigningKeyName": "axon-jwt-signing-key",
    "UseManagedIdentity": true,
    "TenantId": "${AZURE_TENANT_ID:}",
    "ClientId": "${AZURE_CLIENT_ID:}",
    "ClientSecret": "${AZURE_CLIENT_SECRET:}",
    "KeyRotationOverlapHours": 48,
    "KeyCacheDurationMinutes": 60
  },
  "Cors": {
    "PolicyName": "DefaultPolicy",
    "AllowedOrigins": [
      "https://app.axon.ai",
      "https://admin.axon.ai"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["*"],
    "AllowCredentials": true,
    "PreflightMaxAge": 86400
  },
  "DynamicAuth": {
    "BaseUrl": "https://api.dynamic.xyz",
    "ApiKey": "${DYNAMIC_API_KEY:}",
    "TimeoutSeconds": 10
  },
  "DynamicXyz": {
    "BaseUrl": "https://app.dynamic.xyz/api/v0",
    "ApiToken": "${DYNAMIC_API_TOKEN:}",
    "EnvironmentId": "02203765-a9f5-4bf2-a9c8-e6e2e85c3fe1",
    "WebhookSecret": "${DYNAMIC_WEBHOOK_SECRET:}",
    "Jwt": {
      "JwksCacheMinutes": 10,
      "ClockSkewMinutes": 5
    },
    "HttpClient": {
      "TimeoutSeconds": 30,
      "MaxRetryAttempts": 3,
      "RateLimitPerMinute": 500
    }
  },
  "ApiKeyAudiences": {
    "ApiKeys": {
      "${PARTNER1_API_KEY:}": ["${PARTNER1_AUD1:}", "${PARTNER1_AUD2:}"],
      "${PARTNER2_API_KEY:}": ["${PARTNER2_AUD:}"],
      "${PARTNER3_API_KEY:}": ["${PARTNER3_AUD:}"]
    },
    "Default": ["axon-api", "axon-web"]
  },
  "Redis": {
    "KeyPrefix": "axon:replay:"
  },
  "DynamicValidation": {
    "EnvironmentMapping": {
      "02203765-a9f5-4bf2-a9c8-e6e2e85c3fe1": "production",
      "${DYNAMIC_DEV_ENV_ID:}": "development",
      "${DYNAMIC_STAGING_ENV_ID:}": "staging"
    },
    "PartnerAudienceAllowlist": {
      "${PARTNER1_API_KEY:}": ["${PARTNER1_AUD1:}", "${PARTNER1_AUD2:}"],
      "${PARTNER2_API_KEY:}": ["${PARTNER2_AUD:}"]
    },
    "DefaultAllowedAudiences": ["axon-api", "axon-web"],
    "ValidateAudience": true,
    "ClockSkewSeconds": 60,
    "JwksCacheMinutes": 20,
    "EnableBackgroundRefresh": true,
    "BackgroundRefreshMinutes": 15
  },
  "MassTransit": {
    "Transport": "InMemory",
    "EnableOutbox": false,
    "Durable": false,
    "EndpointPrefix": "axon-",
    "PublishTimeout": "00:00:30",
    "IncludeEnvironmentHeaders": true,
    "Outbox": {
      "QueryDelaySeconds": 5,
      "DisableForInMemoryTransport": true
    },
    "Retry": {
      "MaxAttempts": 3,
      "InitialInterval": "00:00:00.200",
      "MaxInterval": "00:00:30",
      "IntervalIncrement": "00:00:00.200"
    }
  },
  "Chat": {
    "UsePocMode": true,
    "OpenAi": {
      "ApiKey": "${OPENAI_API_KEY:}",
      "Model": "gpt-4o-mini",
      "MaxTokens": 4000,
      "TimeoutSeconds": 30,
      "Temperature": 0.7,
      "McpEnabled": true
    },
    "McpServers": {
      "Servers": {
        "CoinGecko": {
          "Enabled": true,
          "ServerUrl": "https://mcp.api.coingecko.com/sse",
          "AllowedTools": [
            "simple/price",
            "coins/markets",
            "coins/{id}",
            "search/trending"
          ]
        }
      }
    }
  }
}
