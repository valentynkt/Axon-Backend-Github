{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Axon.Modules.Chat": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Chat": {
    "OpenAi": {
      "ApiKey": "${OPENAI_API_KEY:}",
      "Model": "o4-mini-2025-04-16",
      "MaxTokens": 4000,
      "TimeoutSeconds": 30,
      "Temperature": 0.7,
      "McpEnabled": true
    },
    "McpServers": {
      "Servers": {
        "CoinGecko": {
          "Enabled": true,
          "ServerUrl": "https://mcp.api.coingecko.com/sse"
        }
      }
    },
    "Cache": {
      "DefaultTtlMinutes": 15,
      "MaxCacheSize": 1000,
      "EnableDistributedCache": false,
      "ConnectionString": "Data Source=cache.db"
    },
    "Performance": {
      "EnableMetrics": true,
      "MetricsEndpoint": "/metrics",
      "SamplingRate": 1.0,
      "EnableTracing": true
    },
    "Monitoring": {
      "ApplicationInsights": {
        "InstrumentationKey": "${AI_INSTRUMENTATION_KEY:}",
        "EnableLiveMetrics": true
      },
      "HealthChecks": {
        "EnableDetailedErrors": true,
        "Timeout": "00:00:30"
      }
    }
  }
}