{
  "Chat": {
    "HttpClient": {
      "TimeoutSeconds": 30,
      "MaxConnectionsPerEndpoint": 10,
      "PooledConnectionLifetimeSeconds": 60,
      "Retry": {
        "MaxRetries": 3,
        "BaseDelayMs": 1000,
        "MaxDelayMs": 10000
      },
      "CircuitBreaker": {
        "FailureThreshold": 5,
        "SamplingDurationSeconds": 30,
        "MinimumThroughput": 3,
        "DurationOfBreakSeconds": 30
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Axon.Modules.Chat.Infrastructure.Services.CachedMcpConfigurationService": "Information",
      "Axon.Modules.Chat.Infrastructure.Services.OptimizedToolExecutionExtractor": "Information", 
      "Axon.Modules.Chat.Infrastructure.Services.BatchJsonSerializer": "Information",
      "Axon.Modules.Chat.Infrastructure.Services.OptimizedHttpClientService": "Information",
      "Axon.Modules.Chat.Infrastructure.Services.PerformanceMonitoringService": "Information"
    }
  }
}