#!/bin/bash
# Pre-commit hook to auto-update documentation index

set -euo pipefail

# Check if any documentation files were modified
if git diff --cached --name-only | grep -E '^Docs/.*\.md$' | grep -v 'INDEX\.md' > /dev/null; then
    echo "📝 Documentation files changed, updating INDEX.md..."
    
    # Update the index
    ./scripts/update-docs-index.sh
    
    # Stage the updated INDEX.md if it was modified
    if [[ -n $(git diff Docs/INDEX.md) ]]; then
        git add Docs/INDEX.md
        echo "✅ Staged updated Docs/INDEX.md"
    fi
fi